<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
	  <!-- Was net8.0-windows7.0 + UseWindowsForms, solely for the Resonite.exe OpenFileDialog prompt.
	       That's now a console prompt / CLI arg / env var / EditorWindow-written config file instead,
	       so this can be a normal cross-platform target matching ImportFromUnityLib. -->
	  <TargetFramework>net10.0</TargetFramework>
	  <OutputType>Exe</OutputType>
	  <RootNamespace>ResoniteUnityExporterStandalone</RootNamespace>
	  <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
	  <PublishSingleFile>true</PublishSingleFile>
	  <ProduceReferenceAssembly>False</ProduceReferenceAssembly>
	  <SelfContained>true</SelfContained>
	  <IncludeAllContentForSelfExtract>true</IncludeAllContentForSelfExtract>
	  <ResonitePath Condition="'$(ResonitePath)' == ''">/mnt/steamdrive/SteamLibrary/steamapps/common/Resonite</ResonitePath>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
    <DebugType>full</DebugType>
    <Optimize>False</Optimize>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
	  <DebugType>full</DebugType>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.CSharp" Version="4.7.0">
		<Properties>TargetFramework=netstandard2.0</Properties>
	</PackageReference>
    <PackageReference Include="ResoniteBridgeLib" Version="1.2.0" />
</ItemGroup>
  <ItemGroup>
    <!-- Reference the live source projects instead of the stale prebuilt Published/ copies, so this
         always builds against whatever ImportFromUnityLib actually is right now. -->
    <ProjectReference Include="..\ImportFromUnityLib\ImportFromUnityLib.csproj" />
    <ProjectReference Include="..\ResoniteUnityExporterShared\ResoniteUnityExporterShared.csproj" />
  </ItemGroup>
</Project>