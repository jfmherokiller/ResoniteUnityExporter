<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Post-"Splittening" Resonite (FrooxEngine.dll etc.) now targets .NETCoreApp v10.0, not classic
         .NET Framework 4.7.2 anymore. Must match or referencing its assemblies mismatches on System.Runtime. -->
    <TargetFramework>net10.0</TargetFramework>
	  <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
	  <SelfContained>false</SelfContained>
	  <PublishSingleFile>false</PublishSingleFile>
	  <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
	  <!-- Post-"Splittening" Resonite installs no longer have a Resonite_Data\Managed subfolder;
	       the managed DLLs now sit directly in the install root. Override with -p:ResonitePath=... if needed. -->
	  <ResonitePath Condition="'$(ResonitePath)' == ''">/mnt/steamdrive/SteamLibrary/steamapps/common/Resonite</ResonitePath>
  </PropertyGroup>

	<Target Name="ClearReferenceCopyLocalPaths" AfterTargets="ResolveAssemblyReferences">
		<ItemGroup>
			<ReferenceCopyLocalPaths Remove="@(ReferenceCopyLocalPaths)" />
		</ItemGroup>
	</Target>

	<ItemGroup>
	  <PackageReference Include="ResoniteBridgeLib" Version="1.2.0" />
	</ItemGroup>

  <ItemGroup>
    <Reference Include="AssimpNet">
      <HintPath>$(ResonitePath)/AssimpNet.dll</HintPath>
      <Aliases>Froox</Aliases>
		<Private>true</Private>
	</Reference>
    <Reference Include="Renderite.Shared">
      <!-- Post-"Splittening": BodyNode and related rig-topology types moved out of FrooxEngine into here,
           since the renderer is now a separate process that needs to share this data. -->
      <HintPath>$(ResonitePath)/Renderite.Shared.dll</HintPath>
      <Aliases>Froox</Aliases>
		<Private>true</Private>
	</Reference>
    <Reference Include="BepuPhysics">
      <HintPath>$(ResonitePath)/BepuPhysics.dll</HintPath>
      <Aliases>Froox</Aliases>
		<Private>true</Private>
	</Reference>
    <Reference Include="Elements.Assets">
      <HintPath>$(ResonitePath)/Elements.Assets.dll</HintPath>
      <Aliases>Froox</Aliases>
		<Private>true</Private>
	</Reference>
    <Reference Include="Elements.Core">
      <HintPath>$(ResonitePath)/Elements.Core.dll</HintPath>
      <Aliases>Froox</Aliases>
		<Private>true</Private>
	</Reference>
    <Reference Include="Elements.Quantity">
      <HintPath>$(ResonitePath)/Elements.Quantity.dll</HintPath>
      <Aliases>Froox</Aliases>
		<Private>true</Private>
	</Reference>
    <Reference Include="FreeImageNET">
      <HintPath>$(ResonitePath)/FreeImageNET.dll</HintPath>
      <Aliases>Froox</Aliases>
      <Private>true</Private>
	</Reference>
    <Reference Include="FrooxEngine">
      <HintPath>$(ResonitePath)/FrooxEngine.dll</HintPath>
      <Aliases>Froox</Aliases>
      <Private>true</Private>
	</Reference>
    <Reference Include="FrooxEngine.Store">
      <HintPath>$(ResonitePath)/FrooxEngine.Store.dll</HintPath>
      <Aliases>Froox</Aliases>
	</Reference>
    <Reference Include="ProtoFlux.Core">
      <HintPath>$(ResonitePath)/ProtoFlux.Core.dll</HintPath>
		<Aliases>Froox</Aliases>
	</Reference>
    <Reference Include="ProtoFlux.Nodes.Core">
      <HintPath>$(ResonitePath)/ProtoFlux.Nodes.Core.dll</HintPath>
		<Aliases>Froox</Aliases>
	</Reference>
    <Reference Include="ProtoFlux.Nodes.FrooxEngine">
      <HintPath>$(ResonitePath)/ProtoFlux.Nodes.FrooxEngine.dll</HintPath>
		<Aliases>Froox</Aliases>
	</Reference>
	<Reference Include="ProtoFluxBindings">
		<HintPath>$(ResonitePath)/ProtoFluxBindings.dll</HintPath>
		<Aliases>Froox</Aliases>
	</Reference>
    <Reference Include="SkyFrost.Base">
      <HintPath>$(ResonitePath)/SkyFrost.Base.dll</HintPath>
      <Aliases>Froox</Aliases>
    </Reference>
    <Reference Include="SkyFrost.Base.Models">
      <HintPath>$(ResonitePath)/SkyFrost.Base.Models.dll</HintPath>
      <Aliases>Froox</Aliases>
    </Reference>
	<Reference Include="ResoniteUnityExporterShared">
		<HintPath>..\Published\ResoniteUnityExporterShared\ResoniteUnityExporterShared.dll</HintPath>
	</Reference>
  </ItemGroup>

</Project>