<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <RootNamespace>ResoniteUnityExporterMod</RootNamespace>
    <AssemblyName>ResoniteUnityExporterMod</AssemblyName>
    <ResonitePath Condition="'$(ResonitePath)' == ''">C:\Program Files (x86)\Steam\steamapps\common\Resonite</ResonitePath>
    <CopyToMods Condition="'$(CopyToMods)' == ''">false</CopyToMods>
  </PropertyGroup>
  <ItemDefinitionGroup>
    <Reference Private="false" />
  </ItemDefinitionGroup>
  <ItemGroup>
    <PackageReference Include="ResoniteModLoader" Version="5.0.1" />
    <PackageReference Include="ResoniteBridgeLib" Version="1.3.0" />
    <ProjectReference Include="..\ImportFromUnityLib\ImportFromUnityLib.csproj" />
    <ProjectReference Include="..\ResoniteUnityExporterShared\ResoniteUnityExporterShared.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="Elements.Assets" HintPath="$(ResonitePath)/Elements.Assets.dll" />
    <Reference Include="Elements.Core" HintPath="$(ResonitePath)/Elements.Core.dll" />
    <Reference Include="Elements.Quantity" HintPath="$(ResonitePath)/Elements.Quantity.dll" />
    <Reference Include="FrooxEngine" HintPath="$(ResonitePath)/FrooxEngine.dll" />
    <Reference Include="ProtoFlux.Nodes.FrooxEngine" HintPath="$(ResonitePath)/ProtoFlux.Nodes.FrooxEngine.dll" />
    <Reference Include="ProtoFluxBindings" HintPath="$(ResonitePath)/ProtoFluxBindings.dll" />
    <Reference Include="SkyFrost.Base" HintPath="$(ResonitePath)/SkyFrost.Base.dll" />
    <Reference Include="SkyFrost.Base.Models" HintPath="$(ResonitePath)/SkyFrost.Base.Models.dll" />
  </ItemGroup>
  <Target Name="LinkModIntoResonite" AfterTargets="Build" Condition="'$(CopyToMods)' == 'true'">
    <MakeDir Directories="$(ResonitePath)/rml_mods" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(ResonitePath)/rml_mods" />
  </Target>
</Project>
